NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Optional but recommended: durable guestbook rate limiting (free tier at upstash.com -> Redis -> REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: "pending" = new notes stay hidden until you set is_approved = true in Supabase
GUESTBOOK_MODERATION=
# Optional: salt for hashing visitor IPs in the rate limiter
RATE_LIMIT_SALT=
# Optional: your custom domain (Vercel's production URL is used automatically)
NEXT_PUBLIC_SITE_URL=

# Optional: lets Pip really talk back and write dreams (both have free tiers).
# Gemini key: aistudio.google.com/apikey   Groq key: console.groq.com/keys
# Server-only. Never prefix with NEXT_PUBLIC_. The site works without them (hand-written fallback).
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional model overrides
GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=llama-3.1-8b-instant
